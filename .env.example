APP_NAME=practiq-be
GIN_MODE=debug
PORT=8083

DB_PORT=54323
DB_HOST=practiq-postgres-db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=practiq-db
DATABASE_URL=postgres://postgres:postgres@practiq-postgres-db:54323/practiq-db?sslmode=disable

# Must match auth-api-be JWT_SECRET exactly (minimum 32 characters)
JWT_SECRET=your-jwt-secret-here-at-least-32-chars-long-example

AUTH_API_URL=http://localhost:8082
FRONTEND_URL=http://localhost:5174
ASSISTANT_PROXY_ALLOWED_PRIVATE_HOSTNAMES=host.docker.internal

# Optional S3 image storage. If empty, image payloads keep old DB/base64 behavior.
AWS_REGION=
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ENDPOINT=
